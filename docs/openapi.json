{
  "openapi": "3.1.0",
  "info": {
    "title": "QueueSmart AI",
    "description": "AI features for QueueSmart, powered by Amazon Bedrock (Claude), Textract, and Location Service. Each endpoint mirrors a Lambda the Backend invokes. Use /docs to try them interactively.",
    "version": "1.0.0"
  },
